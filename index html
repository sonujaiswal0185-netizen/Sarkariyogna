  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family:
        "Noto Sans Devanagari",
        "Segoe UI",
        Arial,
        sans-serif;

      background: #f5f7fb;
      color: #172033;
      line-height: 1.6;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      background: linear-gradient(
        135deg,
        #ff9933,
        #ffffff,
        #138808
      );

      padding: 4px;
    }

    .navbar {
      background: #062b55;
      color: white;

      padding: 14px 6%;

      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 23px;
      font-weight: 800;
    }

    .logo span {
      color: #ff9933;
    }

    .nav-btn {
      background: white;
      color: #062b55;

      border: none;
      padding: 9px 15px;

      border-radius: 8px;
      cursor: pointer;

      font-weight: bold;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      background:
        linear-gradient(
          135deg,
          #063970,
          #0b5cad
        );

      color: white;

      text-align: center;

      padding: 60px 20px;
    }

    .hero h1 {
      font-size: clamp(30px, 5vw, 50px);
      margin-bottom: 10px;
    }

    .hero p {
      max-width: 760px;
      margin: auto;

      color: #e5efff;
      font-size: 17px;
    }

    /* SEARCH */

    .search-box {
      max-width: 800px;
      margin: 30px auto 0;

      background: white;

      padding: 6px;

      border-radius: 12px;

      display: flex;

      box-shadow:
        0 10px 30px rgba(0,0,0,.18);
    }

    .search-box input {
      flex: 1;

      border: none;
      outline: none;

      padding: 14px;

      font-size: 16px;
    }

    .search-box button {
      background: #ff7a00;
      color: white;

      border: none;

      padding: 0 22px;

      border-radius: 8px;

      cursor: pointer;

      font-weight: bold;
    }

    /* =========================
       MAIN
    ========================== */

    .container {
      width: 92%;
      max-width: 1150px;

      margin: 45px auto;
    }

    .section-title {
      text-align: center;

      margin-bottom: 25px;
    }

    .section-title h2 {
      color: #073763;
      font-size: 30px;
    }

    .section-title p {
      color: #667085;
    }

    /* =========================
       CATEGORY
    ========================== */

    .categories {
      display: flex;

      gap: 10px;

      overflow-x: auto;

      padding-bottom: 20px;
    }

    .category {
      white-space: nowrap;

      background: white;

      border: 1px solid #dce4ef;

      padding: 10px 17px;

      border-radius: 25px;

      cursor: pointer;
    }

    .category:hover,
    .category.active {
      background: #0b5cad;
      color: white;
    }

    /* =========================
       NOTICE
    ========================== */

    .notice {
      background: #fff8e5;

      border-left: 5px solid #ffad00;

      padding: 15px;

      border-radius: 7px;

      margin: 20px 0 30px;

      color: #674f00;
    }

    /* =========================
       SCHEME CARDS
    ========================== */

    .schemes {
      display: grid;

      grid-template-columns:
        repeat(
          auto-fit,
          minmax(280px, 1fr)
        );

      gap: 20px;
    }

    .card {
      background: white;

      border-radius: 15px;

      padding: 23px;

      border: 1px solid #e5eaf1;

      box-shadow:
        0 5px 18px rgba(16,24,40,.07);

      transition: .2s;
    }

    .card:hover {
      transform: translateY(-4px);

      box-shadow:
        0 12px 30px rgba(16,24,40,.12);
    }

    .scheme-icon {
      font-size: 36px;

      margin-bottom: 10px;
    }

    .tag {
      display: inline-block;

      background: #fff0e2;

      color: #d55c00;

      padding: 4px 10px;

      border-radius: 20px;

      font-size: 12px;

      margin-bottom: 10px;
    }

    .card h3 {
      color: #073763;

      margin-bottom: 8px;
    }

    .card p {
      color: #667085;

      font-size: 14px;
    }

    .card-buttons {
      display: flex;

      gap: 8px;

      margin-top: 18px;
    }

    .details-btn {
      flex: 1;

      background: #138808;

      color: white;

      border: none;

      padding: 11px;

      border-radius: 8px;

      cursor: pointer;
    }

    .ai-btn {
      background: #0b5cad;

      color: white;

      border: none;

      padding: 11px 15px;

      border-radius: 8px;

      cursor: pointer;
    }

    /* =========================
       AI SECTION
    ========================== */

    .ai-section {
      background: #061a31;

      color: white;

      padding: 55px 20px;

      margin-top: 50px;
    }

    .ai-container {
      width: 92%;
      max-width: 950px;

      margin: auto;
    }

    .ai-title {
      text-align: center;

      margin-bottom: 25px;
    }

    .ai-title h2 {
      font-size: 30px;
    }

    .ai-title p {
      color: #bdc9d8;
    }

    /* CHAT */

    .chat-box {
      background: #102844;

      border-radius: 15px;

      padding: 20px;

      min-height: 280px;

      max-height: 500px;

      overflow-y: auto;
    }

    .message {
      padding: 13px 16px;

      border-radius: 12px;

      margin-bottom: 14px;

      max-width: 90%;
    }

    .bot-message {
      background: #1c385b;
    }

    .user-message {
      background: #0b5cad;

      margin-left: auto;
    }

    .chat-input {
      display: flex;

      gap: 10px;

      margin-top: 15px;
    }

    .chat-input textarea {
      flex: 1;

      resize: none;

      min-height: 58px;

      padding: 13px;

      border: none;

      outline: none;

      border-radius: 9px;

      font-family: inherit;
    }

    .send-btn {
      background: #138808;

      color: white;

      border: none;

      padding: 0 22px;

      border-radius: 9px;

      cursor: pointer;

      font-weight: bold;
    }

    /* =========================
       MODAL
    ========================== */

    .modal {
      position: fixed;

      inset: 0;

      background:
        rgba(0,0,0,.65);

      display: none;

      align-items: center;

      justify-content: center;

      padding: 20px;

      z-index: 999;
    }

    .modal.show {
      display: flex;
    }

    .modal-content {
      background: white;

      width: 100%;
      max-width: 680px;

      max-height: 90vh;

      overflow-y: auto;

      padding: 25px;

      border-radius: 15px;

      position: relative;
    }

    .close {
      position: absolute;

      right: 15px;
      top: 12px;

      width: 35px;
      height: 35px;

      border: none;

      border-radius: 50%;

      background: #eee;

      cursor: pointer;

      font-size: 20px;
    }

    .modal-content h2 {
      color: #073763;

      padding-right: 40px;

      margin-bottom: 18px;
    }

    .info {
      background: #f5f7fb;

      padding: 14px;

      border-radius: 9px;

      margin-bottom: 12px;
    }

    .info strong {
      color: #073763;
    }

    .official-link {
      display: inline-block;

      background: #0b5cad;

      color: white;

      text-decoration: none;

      padding: 11px 18px;

      border-radius: 8px;

      margin-top: 5px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      background: #031020;

      color: #aab8c8;

      text-align: center;

      padding: 28px 15px;
    }

    footer p {
      margin: 4px;
    }

    /* =========================
       MOBILE
    ========================== */

    @media(max-width: 650px) {

      .navbar {
        padding: 13px 4%;
      }

      .logo {
        font-size: 18px;
      }

      .hero {
        padding: 45px 15px;
      }

      .search-box {
        flex-direction: column;

        gap: 5px;

        background: transparent;
      }

      .search-box input {
        border-radius: 8px;
      }

      .search-box button {
        padding: 13px;
      }

      .chat-input {
        flex-direction: column;
      }

      .send-btn {
        padding: 13px;
      }

      .card-buttons {
        flex-direction: column;
      }
    }
  </style>
</head>


